<?xml version="1.0"?>
<robot name="obstacle_robot">

  <!-- ==================== BASE ==================== -->

  <link name="base_link">

    <visual>
      <origin xyz="0 0 0.15"/>
      <geometry>
        <box size="0.40 0.30 0.20"/>
      </geometry>
      <material name="blue">
        <color rgba="0.1 0.3 0.8 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.15"/>
      <geometry>
        <box size="0.40 0.30 0.20"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.15"/>
      <mass value="5.0"/>
      <inertia
        ixx="0.0542"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0833"
        iyz="0.0"
        izz="0.1042"/>
    </inertial>

  </link>


  <!-- ==================== LEFT FRONT WHEEL ==================== -->

  <link name="left_front_wheel">
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
      <material name="black">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>

    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0003" ixy="0" ixz="0"
               iyy="0.0003" iyz="0" izz="0.0003"/>
    </inertial>
  </link>

  <joint name="left_front_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_front_wheel"/>
    <origin xyz="0.15 0.17 0.05"/>
    <axis xyz="0 1 0"/>
  </joint>


  <!-- ==================== LEFT REAR WHEEL ==================== -->

  <link name="left_rear_wheel">
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0003" ixy="0" ixz="0"
               iyy="0.0003" iyz="0" izz="0.0003"/>
    </inertial>
  </link>

  <joint name="left_rear_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_rear_wheel"/>
    <origin xyz="-0.15 0.17 0.05"/>
    <axis xyz="0 1 0"/>
  </joint>


  <!-- ==================== RIGHT FRONT WHEEL ==================== -->

  <link name="right_front_wheel">
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0003" ixy="0" ixz="0"
               iyy="0.0003" iyz="0" izz="0.0003"/>
    </inertial>
  </link>

  <joint name="right_front_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_front_wheel"/>
    <origin xyz="0.15 -0.17 0.05"/>
    <axis xyz="0 1 0"/>
  </joint>


  <!-- ==================== RIGHT REAR WHEEL ==================== -->

  <link name="right_rear_wheel">
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0003" ixy="0" ixz="0"
               iyy="0.0003" iyz="0" izz="0.0003"/>
    </inertial>
  </link>

  <joint name="right_rear_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_rear_wheel"/>
    <origin xyz="-0.15 -0.17 0.05"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ==================== GAZEBO DIFF DRIVE ==================== -->

  <gazebo>
    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">

      <left_joint>left_front_joint</left_joint>
      <left_joint>left_rear_joint</left_joint>

      <right_joint>right_front_joint</right_joint>
      <right_joint>right_rear_joint</right_joint>

      <wheel_separation>0.34</wheel_separation>
      <wheel_radius>0.05</wheel_radius>

      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>

      <publish_odom_tf>false</publish_odom_tf>

      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>

    </plugin>
  </gazebo>
  <!-- ==================== LIDAR ==================== -->

  <link name="lidar_link">

    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.06" length="0.04"/>
      </geometry>
      <material name="lidar_blue">
        <color rgba="0.1 0.1 0.8 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.06" length="0.04"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.1"/>
      <inertia
        ixx="0.0001"
        ixy="0"
        ixz="0"
        iyy="0.0001"
        iyz="0"
        izz="0.0001"/>
    </inertial>

  </link>


  <!-- Fix LiDAR to top of robot -->

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.28" rpy="0 0 0"/>
  </joint>


  <!-- Gazebo LiDAR sensor -->

  <gazebo reference="lidar_link">

    <sensor name="lidar" type="gpu_lidar">

      <pose>0 0 0 0 0 0</pose>

      <topic>scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>

      <update_rate>10</update_rate>

      <ray>

        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>

        <range>
          <min>0.12</min>
          <max>8.0</max>
          <resolution>0.01</resolution>
        </range>

      </ray>

      <always_on>true</always_on>
      <visualize>true</visualize>

    </sensor>

  </gazebo>
    <!-- ==================== CAMERA ==================== -->

  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.06 0.08 0.04"/>
      </geometry>
      <material name="camera_black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
  </link>

  <!-- Fix camera to the front of the robot -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.18 0 0.20" rpy="0 0 0"/>
  </joint>

  <!-- Gazebo camera sensor -->
  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <pose>0 0 0 0 0 0</pose>
      <topic>camera</topic>
      <update_rate>15</update_rate>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
      </camera>
      <always_on>true</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>
</robot>
